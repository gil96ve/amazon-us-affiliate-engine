#!/usr/bin/env bash
# Pre-commit: secretos nunca impresos + linter de contratos.
set -euo pipefail

if git diff --cached --diff-filter=ACM --name-only | grep -Eiq '\.(md|json|html|py|sh|ps1|js|css|yml|yaml)$'; then
  if git diff --cached --unified=0 -- . | grep -Eiq 'gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|sk-[A-Za-z0-9]{20,}|Bearer[[:space:]]+[A-Za-z0-9._-]{20,}'; then
    echo "BLOCKED: posible credencial en el diff staged. Valor redactado." >&2
    exit 1
  fi
fi

PYTHON_BIN="$(command -v python || command -v python3 || true)"
if [[ -n "$PYTHON_BIN" ]]; then
  if ! "$PYTHON_BIN" scripts/validate_contracts.py >/dev/null; then
    echo "BLOCKED: validate_contracts.py fallo. Revise el reporte (sin secretos impresos)." >&2
    exit 1
  fi
fi
